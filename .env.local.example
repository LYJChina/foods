# Copy this file to .env.local and fill in your local values.
# Never commit .env.local or any real API key.

# General and document question answering (OpenAI-compatible API)
DOCUMENT_LLM_BASE_URL=
DOCUMENT_LLM_MODEL=
DOCUMENT_LLM_API_KEY=
DOCUMENT_LLM_TIMEOUT_SECONDS=30

# Multimodal document parsing (OpenAI-compatible API)
MULTIMODAL_API_URL=
MULTIMODAL_MODEL=
MULTIMODAL_API_KEY=
MULTIMODAL_TIMEOUT=120
MULTIMODAL_MAX_CONCURRENCY=2
MULTIMODAL_LAYOUT_MAX_TOKENS=8192

# Internal service connection
DOCUMENT_PARSER_URL=http://127.0.0.1:8002
DOCUMENT_PARSER_TOKEN=
